# Reference only — actual env files live in each app:
#   apps/api/.env          (copy from apps/api/.env.example)
#   apps/web/.env.local    (copy from apps/web/.env.example)
# DO NOT commit .env files

# ── API (apps/api/.env) ──────────────────────────────────
DATABASE_URL="postgresql://spa:spa@localhost:5432/spa_dev?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CORS_ORIGIN="http://localhost:3000"
PORT=3001

# ── Web (apps/web/.env.local) ────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
